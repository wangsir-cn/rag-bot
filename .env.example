# ==================== PostgreSQL ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragbot
DB_USER=postgres
DB_PASSWORD=postgres

# ==================== 默认模型（admin 初始化用，页面可改并存库）====================
# 注意：base-url 不要带 /v1 结尾，Spring AI 会自动拼接 /v1/embeddings 等
OPENAI_API_KEY=sk-change-me
OPENAI_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# ==================== JWT ====================
JWT_SECRET=change-this-to-a-long-random-secret-in-production-2026
JWT_EXPIRATION_HOURS=24

# ==================== 默认管理员（首次登录强制改密）====================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_EMAIL=admin@ragbot.local

# ==================== 邮箱（忘记密码重置；留空则重置链接只打印在后端日志）====================
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# ==================== 文件存储 ====================
# local = 本地磁盘; minio = S3 兼容对象存储
STORAGE_TYPE=minio
RAG_STORAGE_PATH=./storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=rag-bot
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin

# ==================== RAG 调优 ====================
RAG_CHUNK_STRATEGY=SEMANTIC
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
RAG_CANDIDATE_K=30
RAG_SIMILARITY_THRESHOLD=0.25
RAG_FUSION=RRF
RAG_CACHE_ENABLED=false
RAG_RERANK_ENABLED=false
